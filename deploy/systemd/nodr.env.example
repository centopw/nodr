# /etc/nodr/nodr.env — copy to the real file and make it root-owned 0600:
#   install -o root -g root -m 0600 nodr.env.example /etc/nodr/nodr.env
#
# Absolute path to an existing nodr workspace (a directory holding nodr.yaml
# and the git history). nodr never creates one; see docs/guides/production.md
# for how to provision it.
NODR_WORKSPACE=/srv/nodr/workspace
# Loopback by default. Change only when a reverse proxy fronts the server.
NODR_ADDR=127.0.0.1:8080
# Required: base64-encoded 32-byte key encryption key (KEK) that unlocks the
# secret store in <workspace>/.nodr/secrets.db. Generate one with:
#   openssl rand -base64 32
NODR_KEK=
# Optional: one-time bootstrap token for first-run web setup. Set it only for
# the first start, then remove it.
NODR_BOOTSTRAP_TOKEN=
