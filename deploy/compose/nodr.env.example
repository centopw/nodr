# Copy to deploy/compose/nodr.env and fill in. Keep nodr.env out of Git.
#
# Every value below may stay empty. Empty means unset.
#
# Optional: base64-encoded 32-byte key encryption key. When empty, nodr
# generates one at /var/lib/nodr/kek inside the nodr-data volume. Back that
# volume up with the rest of the data; losing the key makes stored credentials
# unrecoverable.
#   openssl rand -base64 32
NODR_KEK=
#
# Unattended bootstrap is all-or-none. Leave all four empty to finish setup in
# the browser (the one-time token is printed to the container log:
# docker compose logs nodr). Or set all four together; setting only some of
# them makes nodr exit before it listens. Inject real values from your secret
# store, never commit them.
#
# Lowercase letters, digits and hyphens; becomes /var/lib/nodr/workspaces/<name>.
NODR_BOOTSTRAP_WORKSPACE_NAME=
NODR_BOOTSTRAP_ADMIN_USERNAME=
NODR_BOOTSTRAP_ADMIN_PASSWORD=
# Authorizes the same one-time setup as browser bootstrap.
NODR_BOOTSTRAP_TOKEN=
#
# GitHub-backed ledger (optional, opt-in; see docs/guides/production.md section 13).
# All four or none: setting only some makes nodr exit before it listens. Leave
# all four empty to keep the local workspace. NODR_GITHUB_PRIVATE_KEY_FILE is a
# path to a mounted secret file, never the key content.
# Public base URL of this server, for example https://nodr.example.com.
NODR_GITHUB_APP_ID=
NODR_GITHUB_PRIVATE_KEY_FILE=
NODR_GITHUB_WEBHOOK_SECRET=
NODR_PUBLIC_URL=
