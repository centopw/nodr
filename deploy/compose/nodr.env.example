# Copy to deploy/compose/nodr.env and fill in. Keep nodr.env out of Git
# (the compose file reads it through env_file and variable substitution).
#
# Absolute path to an existing nodr workspace on the host.
NODR_WORKSPACE=/srv/nodr/workspace
# Required: base64-encoded 32-byte key encryption key.
#   openssl rand -base64 32
NODR_KEK=
# Optional: one-time bootstrap token for first-run web setup.
NODR_BOOTSTRAP_TOKEN=
